# Generate a random secret of at least 50 characters; never commit the real .env file.
# Outside DEBUG the server refuses to start with a shorter or placeholder key.
DJANGO_SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# PostgreSQL is the deployment database. URL-encode special characters in credentials.
DATABASE_URL=postgresql://anasym:CHANGE_ME@localhost:5432/anasym
# Vercel/Supabase integration alternative: used only when DATABASE_URL is empty.
# POSTGRES_URL=postgresql://USER:PASSWORD@CLOUD_HOST:6543/postgres?sslmode=require
# SSL query options are preserved; this optional variable overrides URL sslmode.
# POSTGRES_SSLMODE=require
# Vercel defaults to 0 (close after request); local development defaults to 60.
# DATABASE_CONN_MAX_AGE=0
# DATABASE_CONNECT_TIMEOUT=10
# Explicit local fallback only: clear DATABASE_URL and set USE_SQLITE=true.
USE_SQLITE=false
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
DEMO_MODE=false
DELIVERY_FEE=0.00
# For deployment use SMTP; console email is for development only.
# Set false in a public demo until the external email service is configured.
PASSWORD_RESET_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Anasym <noreply@example.invalid>
# Set secure flags for an HTTPS proxy deployment.
TRUST_PROXY=false
# Direct local server: 0. Behind one trusted reverse proxy: 1.
TRUSTED_PROXY_COUNT=0
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Cross-origin access is off by default (the frontend is served from the same origin).
# List only trusted origins, comma-separated, for a separately hosted frontend.
CORS_ALLOWED_ORIGINS=
# Session lifetime in seconds; 43200 is 12 hours.
SESSION_COOKIE_AGE=43200
# Exact host names allowed for https photo links, comma-separated. Empty means local /images or /media only.
# A host listed here must also be allowed by the img-src rule in deploy/security-headers.conf, or browsers block it.
IMAGE_ALLOWED_HOSTS=
