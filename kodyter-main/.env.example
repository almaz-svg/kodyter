# Copy using scripts/setup-env.ps1 to generate independent random secrets.
DJANGO_SECRET_KEY=GENERATE_WITH_SETUP_SCRIPT
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
POSTGRES_DB=anasym
POSTGRES_USER=anasym
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
COOKIE_SECURE=false
TRUST_PROXY=false
TRUSTED_PROXY_COUNT=0
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Anasym <noreply@example.invalid>
DELIVERY_FEE=1500.00
DEMO_MODE=true
# DOMAIN is only used by deploy/compose.https.yml. Set a real domain before use.
DOMAIN=
